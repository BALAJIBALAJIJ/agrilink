# ==========================================
# AGRILINK Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# Server
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agrilink

# JWT Secret (min 32 chars, use a strong random string)
JWT_SECRET=YourSuperSecretKeyForAgriLinkJWTTokenGeneration2024

# Cloudinary (Sign up at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Credentials
ADMIN_USERNAME=BALAJINADAR
ADMIN_PASSWORD=Admin@Agrilink2024

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL
BACKEND_URL=http://localhost:8080
